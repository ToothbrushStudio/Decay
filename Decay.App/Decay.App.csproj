<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Decay.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Decay</ApplicationTitle>
    <ApplicationId>studio.toothbrush.decay</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <!-- MAUI needs a three-part display version. On Windows it appends ApplicationVersion
         as the fourth part, so 0 here gives the package version 1.0.0.0. -->
    <ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">0</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- Windows runs unpackaged in every configuration: the exe starts directly
       with no MSIX install step or Developer Mode requirement, and the zip we
       ship on itch.io is just the publish folder. A packaged exe launched
       outside its MSIX opens a spinner and then silently exits. For a Store
       (MSIX) build, override on the command line: -p:WindowsPackageType=MSIX -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Bundle the .NET runtime as well, so buyers don't need .NET installed
         (WindowsAppSDKSelfContained only bundles the Windows App SDK). These
         belong here, not on the command line: command-line properties also
         reach the Android and iOS targets and break restore with NU1102. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0A0A0A" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0A0A0A" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Decay.Core\Decay.Core.csproj" />
    <ProjectReference Include="..\Decay.Renderer\Decay.Renderer.csproj" />
    <ProjectReference Include="..\Decay.Licensing\Decay.Licensing.csproj" />
  </ItemGroup>

  <!-- MAUI never regenerates the Windows app icon when it is a single image (no
       ForegroundFile): its up-to-date check reads an empty source name, so an existing
       obj\...\resizetizer\r\appicon.ico always counts as current and a new icon image
       never reaches the exe. Keep a hash of the icon and delete the generated icon files
       when it changes, so MAUI makes them again. -->
  <Target Name="DecayRefreshAppIcon"
          BeforeTargets="ResizetizeImages"
          Condition="'$(_ResizetizerIsWindowsAppSdk)' == 'True' And '$(_MauiIntermediateImages)' != '' And '@(MauiIcon)' != ''">
    <GetFileHash Files="@(MauiIcon)">
      <Output TaskParameter="Items" ItemName="_DecayAppIconWithHash" />
    </GetFileHash>
    <PropertyGroup>
      <_DecayAppIconStamp>$(IntermediateOutputPath)decay-appicon.hash</_DecayAppIconStamp>
      <_DecayAppIconKey>@(_DecayAppIconWithHash->'%(Identity)|%(FileHash)|%(Color)|%(ForegroundFile)')</_DecayAppIconKey>
      <_DecayPreviousAppIconKey Condition="Exists('$(_DecayAppIconStamp)')">$([System.IO.File]::ReadAllText('$(_DecayAppIconStamp)').Trim())</_DecayPreviousAppIconKey>
    </PropertyGroup>
    <ItemGroup Condition="'$(_DecayAppIconKey)' != '$(_DecayPreviousAppIconKey)'">
      <_DecayStaleAppIcon Include="$(_MauiIntermediateImages)%(MauiIcon.Filename).ico;$(_MauiIntermediateImages)%(MauiIcon.Filename)*.png" />
    </ItemGroup>
    <Message Importance="high" Text="App icon changed: regenerating it." Condition="'@(_DecayStaleAppIcon)' != ''" />
    <Delete Files="@(_DecayStaleAppIcon)" />
    <WriteLinesToFile File="$(_DecayAppIconStamp)" Lines="$(_DecayAppIconKey)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_DecayAppIconStamp)" />
    </ItemGroup>
  </Target>

</Project>
