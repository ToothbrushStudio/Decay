<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Decay.App.Pages.EncryptPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Encrypt">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="DECAY YOUR MESSAGE INTO THE ROT"
                   TextColor="{StaticResource Accent}"
                   FontAttributes="Bold" />

            <Editor x:Name="MessageEditor"
                    Placeholder="The message…"
                    HeightRequest="110"
                    TextChanged="OnMessageChanged" />
            <Label x:Name="CapacityLabel"
                   FontSize="12"
                   TextColor="{StaticResource InkDim}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="PassphraseEntry"
                       Grid.Column="0"
                       Placeholder="Passphrase"
                       IsPassword="True"
                       TextChanged="OnPassphraseChanged" />
                <Button x:Name="PassphraseToggle"
                        Grid.Column="1"
                        Text="Show"
                        FontSize="12"
                        BackgroundColor="{StaticResource Panel}"
                        TextColor="{StaticResource Accent}"
                        Clicked="OnTogglePassphrase" />
            </Grid>

            <!-- A typo in the passphrase locks the message away for good, so it's typed twice. -->
            <Entry x:Name="RepeatPassphraseEntry"
                   Placeholder="Repeat passphrase"
                   IsPassword="True"
                   TextChanged="OnPassphraseChanged" />

            <!-- Dropdown titles are separate labels, not the pickers' own Title:
                 on Windows a Title is drawn inside the dropdown control, which
                 makes it taller than the dropdown itself. -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Decay style" />
                <Picker x:Name="StylePicker"
                        SelectedIndexChanged="OnStyleChanged" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Label Text="Carrier" />
                <Picker x:Name="PresetPicker"
                        Grid.Row="1"
                        SelectedIndexChanged="OnPresetChanged" />
                <!-- No vertical padding, so the button never sets the row's height:
                     it stretches to exactly the dropdown's height beside it. -->
                <!-- "New carrier" for a preset; "Choose image… (PNG)" for Custom Image. -->
                <Button x:Name="NewCarrierButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="11,0"
                        Text="New carrier"
                        Clicked="OnNewCarrier" />
            </Grid>

            <Button x:Name="AdvancedToggle"
                    Text="Advanced ▸"
                    FontSize="12"
                    BackgroundColor="{StaticResource Panel}"
                    TextColor="{StaticResource Accent}"
                    Clicked="OnToggleAdvanced" />

            <VerticalStackLayout x:Name="AdvancedSection" Spacing="12" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Size" />
                    <Picker x:Name="SizePicker"
                            SelectedIndexChanged="OnSizeChanged" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Intensity" VerticalOptions="Center" />
                    <Slider x:Name="IntensitySlider"
                            Grid.Column="1"
                            Minimum="1" Maximum="255" Value="100"
                            ValueChanged="OnIntensityChanged" />
                    <Label x:Name="IntensityValueLabel"
                           Grid.Column="2"
                           Text="100"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Accent}" />
                </Grid>

                <HorizontalStackLayout x:Name="DevTierRow" Spacing="8">
                    <Switch x:Name="ProSwitch" Toggled="OnProToggled" />
                    <Label Text="Pro override (debug builds only)"
                           FontSize="12"
                           VerticalOptions="Center"
                           TextColor="{StaticResource InkDim}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button x:Name="EncryptButton" Text="Encrypt" Clicked="OnEncrypt" />

            <Border BackgroundColor="{StaticResource Panel}"
                    StrokeThickness="1"
                    Stroke="{StaticResource InkDim}">
                <Image x:Name="Preview"
                       Aspect="AspectFit"
                       HeightRequest="320" />
            </Border>

            <Grid x:Name="ResultRow" IsVisible="False" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="PlayButton" Grid.Column="0" Text="Play decay"
                        IsEnabled="False" Clicked="OnPlayDecay" />
                <Button x:Name="SaveImageButton" Grid.Column="1" Text="Save image…"
                        IsEnabled="False" Clicked="OnSaveImage" />
                <Button x:Name="ShareButton" Grid.Column="2" Text="Share PNG"
                        IsEnabled="False" Clicked="OnShare" />
            </Grid>

            <Label x:Name="StatusLabel"
                   FontSize="12"
                   TextColor="{StaticResource InkDim}" />

            <Button Text="⚠ Send the PNG file itself, never a screenshot. How to send and test it (Help)…"
                    FontSize="12"
                    BackgroundColor="{StaticResource Panel}"
                    TextColor="{StaticResource Warn}"
                    Clicked="OnHowToSend" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
