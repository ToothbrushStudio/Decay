<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Decay.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Decay.App.Pages"
    Shell.BackgroundColor="{StaticResource Ground}"
    Shell.ForegroundColor="{StaticResource Accent}"
    Shell.TitleColor="{StaticResource Ink}"
    Shell.TabBarBackgroundColor="{StaticResource Panel}"
    Shell.TabBarTitleColor="{StaticResource Accent}"
    Shell.TabBarUnselectedColor="{StaticResource InkDim}">
    <TabBar>
        <ShellContent Title="Encrypt" ContentTemplate="{DataTemplate pages:EncryptPage}" Route="encrypt" />
        <ShellContent Title="Decrypt" ContentTemplate="{DataTemplate pages:DecryptPage}" Route="decrypt" />
        <ShellContent Title="License" ContentTemplate="{DataTemplate pages:LicensePage}" Route="license" />
    </TabBar>
</Shell>
